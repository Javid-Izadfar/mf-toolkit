{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"],
    "types": []
  },
  "include": ["src"],
  // Build compiles src only. examples/ (playground), test/, and bench/ are
  // dev-only and must never land in dist or the published package.
  "exclude": ["dist", "node_modules", "examples", "test", "bench"]
}
